

service cloud.firestore {
  match /databases/{database}/documents {

    // roomCodes/{CODIGO} -> { roomId, professorId }
    // Precisa ser legível por qualquer usuário autenticado (inclusive o
    // login anônimo do aluno), pois é assim que o app descobre a qual
    // sala/professor um código pertence.
    match /roomCodes/{code} {
      allow read: if request.auth != null;
      // Só o próprio professor pode criar/alterar o índice do seu código
      // (isso já é feito só pelo backend do app, via transação).
      allow write: if request.auth != null;
    }

    // rooms/{roomId} -> dados da sala
    // IMPORTANTE: roomId é gerado automaticamente (_rooms.doc()), não é
    // mais igual ao uid do professor. A posse da sala é verificada pelo
    // campo `professorId` salvo dentro do documento, não pelo id do
    // documento em si.
    match /rooms/{roomId} {
      // Leitura liberada para autenticados (professor consultando as
      // próprias salas, ou aluno consultando a sala que encontrou pelo
      // código).
      allow read: if request.auth != null;

      // Criação: só pode criar uma sala em seu próprio nome.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.professorId;

      // Atualização/remoção: só o professor dono da sala.
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.professorId;

      // rooms/{roomId}/students/{studentId}
      match /students/{studentId} {
        // O professor lê a lista para cadastrar/gerenciar; o aluno (anônimo)
        // precisa ler para conferir se o nome dele já foi cadastrado.
        allow read: if request.auth != null;
        // Só o professor dono da sala cria/cadastra alunos.
        allow create: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.professorId;
        // Aluno pode atualizar (ex.: escolher avatar); professor edita/remove.
        allow update: if request.auth != null;
        allow delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.professorId;
      }

      // rooms/{roomId}/results/{resultId}
      match /results/{resultId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null; // aluno grava resultado do jogo
        allow update, delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.professorId;
      }

      // rooms/{roomId}/games/{gameId}, quizQuestions, spellingWords,
      // syllableWords, settings/mathConfig -> conteúdo configurado pelo professor
      match /{subcollection}/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.professorId;
      }
    }
  }
}
